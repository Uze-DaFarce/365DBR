        "chapterIds": [
          "PRO.30"
        ],
        "reference": "Proverbs 30:20-21",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "So—the way of an adulterous woman, || She has eaten and has wiped her mouth, || And has said, “I have not done iniquity.” ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.30.20",
                  "verseOrgIds": [
                    "PRO.30.20"
                  ]
                }
              },
              {
                "text": "For three things has earth been troubled, || And for four—it is not able to bear: ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.30.21",
                  "verseOrgIds": [
                    "PRO.30.21"
                  ]
                }
              }
            ]
          }
        ],
