        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "Such ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.30.20",
                  "verseOrgIds": [
                    "PRO.30.20"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "add"
                },
                "items": [
                  {
                    "text": "is",
                    "type": "text",
                    "attrs": {
                      "verseId": "PRO.30.20",
                      "verseOrgIds": [
                        "PRO.30.20"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " the way of an adulterous woman; she eateth, and wipeth her mouth, and saith, I have done no wickedness. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.30.20",
                  "verseOrgIds": [
                    "PRO.30.20"
                  ]
                }
              },
              {
                "text": "For three ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.30.21",
                  "verseOrgIds": [
                    "PRO.30.21"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "add"
                },
                "items": [
                  {
                    "text": "things",
                    "type": "text",
                    "attrs": {
                      "verseId": "PRO.30.21",
                      "verseOrgIds": [
                        "PRO.30.21"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " the earth is disquieted, and for four ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.30.21",
                  "verseOrgIds": [
                    "PRO.30.21"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "add"
                },
                "items": [
                  {
                    "text": "which",
                    "type": "text",
                    "attrs": {
                      "verseId": "PRO.30.21",
                      "verseOrgIds": [
                        "PRO.30.21"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " it cannot bear: ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.30.21",
                  "verseOrgIds": [
                    "PRO.30.21"
                  ]
                }
              }
            ]
          }
        ],
