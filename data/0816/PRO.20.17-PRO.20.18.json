            "items": [
              {
                "text": "The bread of falsehood [is] sweet to a man, || And afterward his mouth is filled [with] gravel. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.17",
                  "verseOrgIds": [
                    "PRO.20.17"
                  ]
                }
              },
              {
                "text": "You establish purposes by counsel, || And with plans you make war. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.18",
                  "verseOrgIds": [
                    "PRO.20.18"
                  ]
                }
              }
            ]
