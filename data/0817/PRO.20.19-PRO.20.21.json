        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "He that goeth about ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.19",
                  "verseOrgIds": [
                    "PRO.20.19"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "add"
                },
                "items": [
                  {
                    "text": "as",
                    "type": "text",
                    "attrs": {
                      "verseId": "PRO.20.19",
                      "verseOrgIds": [
                        "PRO.20.19"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " a talebearer revealeth secrets: therefore meddle not with him that flattereth with his lips.",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.19",
                  "verseOrgIds": [
                    "PRO.20.19"
                  ]
                }
              },
              {
                "text": " ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.19",
                  "verseOrgIds": [
                    "PRO.20.19"
                  ]
                }
              },
              {
                "text": "Whoso curseth his father or his mother, his lamp shall be put out in obscure darkness.",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.20",
                  "verseOrgIds": [
                    "PRO.20.20"
                  ]
                }
              },
              {
                "text": " ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.20",
                  "verseOrgIds": [
                    "PRO.20.20"
                  ]
                }
              },
              {
                "text": "An inheritance ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.21",
                  "verseOrgIds": [
                    "PRO.20.21"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "add"
                },
                "items": [
                  {
                    "text": "may be",
                    "type": "text",
                    "attrs": {
                      "verseId": "PRO.20.21",
                      "verseOrgIds": [
                        "PRO.20.21"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " gotten hastily at the beginning; but the end thereof shall not be blessed. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.21",
                  "verseOrgIds": [
                    "PRO.20.21"
                  ]
                }
              }
            ]
          }
        ],
        "verseCount": 3,
        "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent"
      },
      {
        "id": "PRO.20.19-PRO.20.21",
        "orgId": "PRO.20.19-PRO.20.21",
        "bibleId": "01b29f4b342acc35-01",
        "bookId": "PRO",
        "chapterIds": [
          "PRO.20"
        ],
        "reference": "Proverbs 20:19-21",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "The busybody is a revealer of secret counsels, || And do not make yourself guarantor for a deceiver [with] his lips. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.19",
                  "verseOrgIds": [
                    "PRO.20.19"
                  ]
                }
              },
              {
                "text": "Whoever is vilifying his father and his mother, his lamp is extinguished in blackness of darkness. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.20",
                  "verseOrgIds": [
                    "PRO.20.20"
                  ]
                }
              },
              {
                "text": "An inheritance gotten wrongly at first, || Even its latter end is not blessed. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.21",
                  "verseOrgIds": [
                    "PRO.20.21"
                  ]
                }
              }
            ]
          }
        ],
