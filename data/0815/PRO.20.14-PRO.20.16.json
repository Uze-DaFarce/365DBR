        "reference": "Proverbs 20:14-16",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "“Bad, bad,” says the buyer, || And then he boasts himself going his way. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.14",
                  "verseOrgIds": [
                    "PRO.20.14"
                  ]
                }
              },
              {
                "text": "Substance, gold, and a multitude of rubies, || Indeed, a precious vessel, [are] lips of knowledge. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.15",
                  "verseOrgIds": [
                    "PRO.20.15"
                  ]
                }
              },
              {
                "text": "When a stranger has been guarantor, take his garment, || And pledge it for strangers. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.20.16",
                  "verseOrgIds": [
                    "PRO.20.16"
                  ]
                }
              }
            ]
          }
        ],
