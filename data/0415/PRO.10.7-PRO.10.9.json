        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "The memory of the just ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.10.7",
                  "verseOrgIds": [
                    "PRO.10.7"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "add"
                },
                "items": [
                  {
                    "text": "is",
                    "type": "text",
                    "attrs": {
                      "verseId": "PRO.10.7",
                      "verseOrgIds": [
                        "PRO.10.7"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " blessed: but the name of the wicked shall rot. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.10.7",
                  "verseOrgIds": [
                    "PRO.10.7"
                  ]
                }
              },
              {
                "text": "The wise in heart will receive commandments: but a prating fool shall fall.",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.10.8",
                  "verseOrgIds": [
                    "PRO.10.8"
                  ]
                }
              },
              {
                "text": " ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.10.8",
                  "verseOrgIds": [
                    "PRO.10.8"
                  ]
                }
              },
              {
                "text": "He that walketh uprightly walketh surely: but he that perverteth his ways shall be known. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.10.9",
                  "verseOrgIds": [
                    "PRO.10.9"
                  ]
                }
              }
            ]
          }
        ],
        "verseCount": 3,
        "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent"
      },
      {
        "id": "PRO.10.7-PRO.10.9",
        "orgId": "PRO.10.7-PRO.10.9",
        "bibleId": "01b29f4b342acc35-01",
        "bookId": "PRO",
        "chapterIds": [
          "PRO.10"
        ],
        "reference": "Proverbs 10:7-9",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "The remembrance of the righteous [is] for a blessing, || And the name of the wicked rots. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.10.7",
                  "verseOrgIds": [
                    "PRO.10.7"
                  ]
                }
              },
              {
                "text": "The wise in heart accepts commands, || And a talkative fool kicks. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.10.8",
                  "verseOrgIds": [
                    "PRO.10.8"
                  ]
                }
              },
              {
                "text": "Whoever is walking in integrity walks confidently, || And whoever is perverting his ways is known. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.10.9",
                  "verseOrgIds": [
                    "PRO.10.9"
                  ]
                }
              }
            ]
          }
        ],
