    "parallels": [
      {
        "id": "PSA.18.21-PSA.18.27",
        "orgId": "PSA.18.22-PSA.18.28",
        "bibleId": "de4e12af7f28f599-01",
        "bookId": "PSA",
        "chapterIds": [
          "PSA.18"
        ],
        "reference": "Psalms 18:21-27",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "q1"
            },
            "items": [
              {
                "text": "For I have kept the ways of the ",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.21",
                  "verseOrgIds": [
                    "PSA.18.22"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "nd"
                },
                "items": [
                  {
                    "text": "LORD",
                    "type": "text",
                    "attrs": {
                      "verseId": "PSA.18.21",
                      "verseOrgIds": [
                        "PSA.18.22"
                      ]
                    }
                  }
                ]
              },
              {
                "text": ", and have not wickedly departed from my God.",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.21",
                  "verseOrgIds": [
                    "PSA.18.22"
                  ]
                }
              }
            ]
          },
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "q1"
            },
            "items": [
              {
                "text": "For all his judgments ",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.22",
                  "verseOrgIds": [
                    "PSA.18.23"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "add"
                },
                "items": [
                  {
                    "text": "were",
                    "type": "text",
                    "attrs": {
                      "verseId": "PSA.18.22",
                      "verseOrgIds": [
                        "PSA.18.23"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " before me, and I did not put away his statutes from me.",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.22",
                  "verseOrgIds": [
                    "PSA.18.23"
                  ]
                }
              }
            ]
          },
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "q1"
            },
            "items": [
              {
                "text": "I was also upright before him, and I kept myself from mine iniquity.",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.23",
                  "verseOrgIds": [
                    "PSA.18.24"
                  ]
                }
              }
            ]
          },
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "q1"
            },
            "items": [
              {
                "text": "Therefore hath the ",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.24",
                  "verseOrgIds": [
                    "PSA.18.25"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "nd"
                },
                "items": [
                  {
                    "text": "LORD",
                    "type": "text",
                    "attrs": {
                      "verseId": "PSA.18.24",
                      "verseOrgIds": [
                        "PSA.18.25"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " recompensed me according to my righteousness, according to the cleanness of my hands in his eyesight.",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.24",
                  "verseOrgIds": [
                    "PSA.18.25"
                  ]
                }
              }
            ]
          },
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "q1"
            },
            "items": [
              {
                "text": "With the merciful thou wilt shew thyself merciful; with an upright man thou wilt shew thyself upright;",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.25",
                  "verseOrgIds": [
                    "PSA.18.26"
                  ]
                }
              }
            ]
          },
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "q1"
            },
            "items": [
              {
                "text": "With the pure thou wilt shew thyself pure; and with the froward thou wilt shew thyself froward.",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.26",
                  "verseOrgIds": [
                    "PSA.18.27"
                  ]
                }
              }
            ]
          },
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "q1"
            },
            "items": [
              {
                "text": "For thou wilt save the afflicted people; but wilt bring down high looks.",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.27",
                  "verseOrgIds": [
                    "PSA.18.28"
                  ]
                }
              }
            ]
          }
        ],
        "verseCount": 7,
        "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent"
      },
      {
        "id": "PSA.18.21-PSA.18.27",
        "orgId": "PSA.18.22-PSA.18.28",
        "bibleId": "01b29f4b342acc35-01",
        "bookId": "PSA",
        "chapterIds": [
          "PSA.18"
        ],
        "reference": "Psalms 18:21-27",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "For I have kept the ways of YHWH, || And have not done wickedly against my God. ",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.21",
                  "verseOrgIds": [
                    "PSA.18.22"
                  ]
                }
              },
              {
                "text": "For all His judgments [are] before me, || And I do not turn His statutes from me. ",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.22",
                  "verseOrgIds": [
                    "PSA.18.23"
                  ]
                }
              },
              {
                "text": "And I am perfect with Him, || And I keep myself from my iniquity. ",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.23",
                  "verseOrgIds": [
                    "PSA.18.24"
                  ]
                }
              },
              {
                "text": "And YHWH returns to me, || According to my righteousness, || According to the cleanness of my hands, || Before His eyes. ",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.24",
                  "verseOrgIds": [
                    "PSA.18.25"
                  ]
                }
              },
              {
                "text": "With the kind You show Yourself kind, || With a perfect man You show Yourself perfect. ",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.25",
                  "verseOrgIds": [
                    "PSA.18.26"
                  ]
                }
              },
              {
                "text": "With the pure You show Yourself pure, || And with the perverse You show Yourself a wrestler, ",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.26",
                  "verseOrgIds": [
                    "PSA.18.27"
                  ]
                }
              },
              {
                "text": "For You save a poor people, || And cause the eyes of the high to fall. ",
                "type": "text",
                "attrs": {
                  "verseId": "PSA.18.27",
                  "verseOrgIds": [
                    "PSA.18.28"
                  ]
                }
              }
            ]
          }
        ],
