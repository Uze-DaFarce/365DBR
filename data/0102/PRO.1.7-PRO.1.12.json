                  "verseId": "PRO.1.7",
                  "verseOrgIds": [
                    "PRO.1.7"
                  ]
                }
              },
              {
                "text": "My son, hear the instruction of thy father, and forsake not the law of thy mother: ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.1.8",
                  "verseOrgIds": [
                    "PRO.1.8"
                  ]
                }
              },
              {
                "text": "For they ",
                "type": "text",
