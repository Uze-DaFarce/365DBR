    "parallels": [
      {
        "id": "PRO.4.1-PRO.4.3",
        "orgId": "PRO.4.1-PRO.4.3",
        "bibleId": "de4e12af7f28f599-01",
        "bookId": "PRO",
        "chapterIds": [
          "PRO.4"
        ],
        "reference": "Proverbs 4:1-3",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "Hear, ye children, the instruction of a father, and attend to know understanding. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.1",
                  "verseOrgIds": [
                    "PRO.4.1"
                  ]
                }
              },
              {
                "text": "For I give you good doctrine, forsake ye not my law. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.2",
                  "verseOrgIds": [
                    "PRO.4.2"
                  ]
                }
              },
              {
                "text": "For I was my father’s son, tender and only ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.3",
                  "verseOrgIds": [
                    "PRO.4.3"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "add"
                },
                "items": [
                  {
                    "text": "beloved",
                    "type": "text",
                    "attrs": {
                      "verseId": "PRO.4.3",
                      "verseOrgIds": [
                        "PRO.4.3"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " in the sight of my mother. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.3",
                  "verseOrgIds": [
                    "PRO.4.3"
                  ]
                }
              }
            ]
          }
        ],
        "verseCount": 3,
        "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent"
      },
      {
        "id": "PRO.4.1-PRO.4.3",
        "orgId": "PRO.4.1-PRO.4.3",
        "bibleId": "01b29f4b342acc35-01",
        "bookId": "PRO",
        "chapterIds": [
          "PRO.4"
        ],
        "reference": "Proverbs 4:1-3",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "Hear, you sons, the instruction of a father, || And give attention to know understanding. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.1",
                  "verseOrgIds": [
                    "PRO.4.1"
                  ]
                }
              },
              {
                "text": "For I have given to you good learning, do not forsake my law. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.2",
                  "verseOrgIds": [
                    "PRO.4.2"
                  ]
                }
              },
              {
                "text": "For I have been a son to my father—tender, || And an only one before my mother. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.3",
                  "verseOrgIds": [
                    "PRO.4.3"
                  ]
                }
              }
            ]
          }
        ],
        "verseCount": 3,
