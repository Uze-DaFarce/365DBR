        "reference": "Proverbs 4:14-15",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "Do not enter into the path of the wicked, || And do not be blessed in a way of evildoers. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.14",
                  "verseOrgIds": [
                    "PRO.4.14"
                  ]
                }
              },
              {
                "text": "Avoid it, do not pass over into it, || Turn aside from it, and pass on. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.15",
                  "verseOrgIds": [
                    "PRO.4.15"
                  ]
                }
              }
            ]
          }
