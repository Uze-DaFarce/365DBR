                  {
                    "text": "men",
                    "type": "text",
                    "attrs": {
                      "verseId": "PRO.4.14",
                      "verseOrgIds": [
                        "PRO.4.14"
                      ]
                    }
                  }
                ]
              },
              {
                "text": ". ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.14",
                  "verseOrgIds": [
                    "PRO.4.14"
                  ]
                }
              },
              {
                "text": "Avoid it, pass not by it, turn from it, and pass away. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.15",
                  "verseOrgIds": [
                    "PRO.4.15"
                  ]
                }
              }
            ]
