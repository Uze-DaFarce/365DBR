        "reference": "Proverbs 6:3-4",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "Do this now, my son, and deliver thyself, when thou art come into the hand of thy friend; go, humble thyself, and make sure thy friend.",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.6.3",
                  "verseOrgIds": [
                    "PRO.6.3"
                  ]
                }
              },
              {
                "text": " ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.6.3",
                  "verseOrgIds": [
                    "PRO.6.3"
                  ]
                }
              },
              {
                "text": "Give not sleep to thine eyes, nor slumber to thine eyelids. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.6.4",
                  "verseOrgIds": [
                    "PRO.6.4"
                  ]
                }
              }
            ]
          }
        ],
        "verseCount": 2,
