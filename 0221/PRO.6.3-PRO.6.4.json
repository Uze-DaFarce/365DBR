        "reference": "Proverbs 6:3-4",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "Do this now, my son, and be delivered, || For you have come into the hand of your friend. Go, trample on yourself, and strengthen your friend, ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.6.3",
                  "verseOrgIds": [
                    "PRO.6.3"
                  ]
                }
              },
              {
                "text": "Do not give sleep to your eyes, || And slumber to your eyelids, ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.6.4",
                  "verseOrgIds": [
                    "PRO.6.4"
                  ]
                }
              }
            ]
          }
        ],
