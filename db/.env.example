# 365DBR Local Postgres Dev Environment
# Copy to .env (or set as system/user env vars) and customize.
# NEVER commit real secrets. This file is for local dev only.
#
# Docker Compose will read these when starting the postgres service.
# Python scripts prefer DATABASE_URL but fall back to components.

POSTGRES_DB=mt_sinai_365dbr
POSTGRES_USER=365dbr_dev
POSTGRES_PASSWORD=dev_password_change_me_please_use_a_strong_one
POSTGRES_PORT=5432

# Full connection string used by apply/verify scripts.
# Format: postgresql://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgresql://365dbr_dev:dev_password_change_me_please_use_a_strong_one@localhost:5432/mt_sinai_365dbr

# Optional: override host if connecting to a remote or different container
# POSTGRES_HOST=localhost
