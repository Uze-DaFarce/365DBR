# daybydaykids.com device-based redirect - at top for priority
<IfModule mod_rewrite.c>
RewriteEngine On

# Desktop → mt-sin.ai/HeIsRisen/
# Mobile  → mt-sin.ai/m/
RewriteCond %{HTTP_HOST} ^(www\.)?daybydaykids\.com$ [NC]

# Mobile detection first
RewriteCond %{HTTP_USER_AGENT} "android|iphone|ipad|ipod|blackberry|windows phone|iemobile|opera mini|mobile" [NC]
RewriteRule ^(.*)$ https://mt-sin.ai/m/ [R=302,L]

# Desktop fallback
RewriteCond %{HTTP_HOST} ^(www\.)?daybydaykids\.com$ [NC]
RewriteRule ^(.*)$ https://mt-sin.ai/HeIsRisen/ [R=302,L]
</IfModule>

# 🛡️ Sentinel: Server Hardening
# Prevent server version information leakage
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 🚦 Router: Case-insensitive and trailing slash redirects

  # Redirect variants of HeIsRisen
  RewriteCond %{REQUEST_URI} ^/heisrisen(?:/|$) [NC]
  RewriteCond %{REQUEST_URI} !^/HeIsRisen/
  RewriteRule ^heisrisen/?(.*)$ /HeIsRisen/$1 [R=301,NC,L]

  # Redirect variants of m
  RewriteCond %{REQUEST_URI} ^/m(?:/|$) [NC]
  RewriteCond %{REQUEST_URI} !^/m/
  RewriteRule ^m/?(.*)$ /m/$1 [R=301,NC,L]

  # Redirect variants of 365DBR
  RewriteCond %{REQUEST_URI} ^/365dbr(?:/|$) [NC]
  RewriteCond %{REQUEST_URI} !^/365DBR/
  RewriteRule ^365dbr/?(.*)$ /365DBR/$1 [R=301,NC,L]

  # Redirect variants of CMC
  RewriteCond %{REQUEST_URI} ^/cmc(?:/|$) [NC]
  RewriteCond %{REQUEST_URI} !^/CMC/
  RewriteRule ^cmc/?(.*)$ /CMC/$1 [R=301,NC,L]
</IfModule>

<IfModule mod_autoindex.c>
  # 🛡️ Sentinel: Disable directory listing
  # Prevents attackers from enumerating files in directories like /pics or /css
  Options -Indexes
</IfModule>

<IfModule mod_headers.c>
  # 🛡️ Sentinel: Prevent technology stack leakage
  Header unset X-Powered-By

  # 🛡️ Sentinel: Security Headers Enhancement
  # Added to enforce strict security policies at the server level (Apache)

  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Prevent clickjacking (header defense)
  Header set X-Frame-Options "DENY"

  # Enable XSS protection filter in legacy browsers
  Header set X-XSS-Protection "1; mode=block"

  # Strict Referrer Policy to protect user privacy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS (Strict Transport Security) - 1 year, include subdomains, preload
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Permissions Policy - Disable sensitive features not used by the site
  # Added usb, interest-cohort (FLoC), browsing-topics, and publickey-credentials-get for defense in depth.
  # Note: Sub-sites (like 365DBR) override this policy in their own .htaccess to enable required features (e.g., WebAuthn).
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=(), browsing-topics=(), publickey-credentials-get=()"

  # Prevent Adobe Flash and PDF data leakage
  Header set X-Permitted-Cross-Domain-Policies "none"

  # 🛡️ Sentinel: Process Isolation
  # Ensures that the page is isolated in its own browsing context, preventing cross-origin attacks (Spectre)
  # and interactions from other windows (e.g. malicious popups).
  Header set Cross-Origin-Opener-Policy "same-origin"

  # Content Security Policy (CSP)
  # Matches index.html policy but adds 'frame-ancestors' (ignored in meta tags) for anti-framing protection.
  # Note: 404.html has a stricter meta-tag CSP which will take precedence for that page where directives overlap.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; frame-src 'none'; object-src 'none'; worker-src 'none'; base-uri 'self'; form-action 'self' https://docs.google.com; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script';"
</IfModule>

<IfModule mod_alias.c>
  # 🛡️ Sentinel: Block access to hidden files/directories (dotfiles)
  # Prevents leakage of sensitive config like .git, .env, or .Jules
  # Exceptions: .well-known (standard for security.txt, SSL validation)
  RedirectMatch 403 "(^|/)\.(?!well-known(?:$|/))"

  # 🛡️ Sentinel: Block access to sensitive source/config files
  # Prevents leakage of internal documentation, logs, and scripts
  # Blocks: .py, .log, .sh, .bak, .swp
  # Note: .md is allowed as sub-sites (like 365DBR) may serve markdown content
  RedirectMatch 403 "(?i)\.(py|log|sh|bak|swp)$"
</IfModule>

<IfModule mod_deflate.c>
  # ⚡ Bolt: Compress text-based assets to reduce transfer size
  # Compresses HTML, CSS, JS, SVG, and JSON before sending to client
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  # ⚡ Bolt: Enable browser caching to reduce repeat requests
  # Instructs browser to keep static assets in local cache for specified duration
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  # CSS and JavaScript (1 hour - reduced from 1 month for safer updates on sub-sites without versioning)
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"

  # Images (1 year - aggressive caching for static assets)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts (1 year)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # HTML (Always revalidate to ensure fresh content)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
