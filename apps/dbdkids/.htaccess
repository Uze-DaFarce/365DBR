# Day by Day Kids (daybydaykids.com) — Static Security & Caching
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS + canonical apex domain in production (skip localhost/127.0.0.1)
  RewriteCond %{HTTP_HOST} ^(www\.)?daybydaykids\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.daybydaykids\.com$ [NC]
  RewriteRule ^ https://daybydaykids.com%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Reset any inherited parent headers (safe if hosted under /public_html/dbdkids/ or sibling root)
  Header always unset Content-Security-Policy
  Header unset Content-Security-Policy
  Header always unset X-Frame-Options
  Header unset X-Frame-Options

  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src 'self' https://mt-sin.ai http://localhost:8080 http://127.0.0.1:8080; frame-ancestors 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self';"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Fresh HTML & Service Worker
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>

  # Long cache for static assets
  <FilesMatch "\.(webp|png|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
