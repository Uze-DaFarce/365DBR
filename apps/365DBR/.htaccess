<IfModule mod_headers.c>
    # 🛡️ Bolt: Enhanced Security Headers
    # Includes GoDaddy/Secureserver compatibility
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://esm.sh https://img1.wsimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://esm.sh https://csp.secureserver.net;"

    # Enable WebAuthn and other features
    Header set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(), usb=(), interest-cohort=(), browsing-topics=(), publickey-credentials-get=(self)"

    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # Standard Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
