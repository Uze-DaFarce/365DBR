        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "When thou goest, thy steps shall not be straitened; and when thou runnest, thou shalt not stumble. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.12",
                  "verseOrgIds": [
                    "PRO.4.12"
                  ]
                }
              },
              {
                "text": "Take fast hold of instruction; let ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.13",
                  "verseOrgIds": [
                    "PRO.4.13"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "add"
                },
                "items": [
                  {
                    "text": "her",
                    "type": "text",
                    "attrs": {
                      "verseId": "PRO.4.13",
                      "verseOrgIds": [
                        "PRO.4.13"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " not go: keep her; for she ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.13",
                  "verseOrgIds": [
                    "PRO.4.13"
                  ]
                }
              },
              {
                "name": "char",
                "type": "tag",
                "attrs": {
                  "style": "add"
                },
                "items": [
                  {
                    "text": "is",
                    "type": "text",
                    "attrs": {
                      "verseId": "PRO.4.13",
                      "verseOrgIds": [
                        "PRO.4.13"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " thy life.",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.13",
                  "verseOrgIds": [
                    "PRO.4.13"
                  ]
                }
              }
            ]
          }
        ],
        "verseCount": 2,
        "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent"
      },
      {
        "id": "PRO.4.12-PRO.4.13",
        "orgId": "PRO.4.12-PRO.4.13",
        "bibleId": "01b29f4b342acc35-01",
        "bookId": "PRO",
        "chapterIds": [
          "PRO.4"
        ],
        "reference": "Proverbs 4:12-13",
        "content": [
          {
            "name": "para",
            "type": "tag",
            "attrs": {
              "style": "p"
            },
            "items": [
              {
                "text": "In your walking your step is not restricted, || And if you run, you do not stumble. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.12",
                  "verseOrgIds": [
                    "PRO.4.12"
                  ]
                }
              },
              {
                "text": "Lay hold on instruction, do not desist, || Keep her, for she [is] your life. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.4.13",
                  "verseOrgIds": [
                    "PRO.4.13"
                  ]
                }
              }
            ]
          }
        ],
