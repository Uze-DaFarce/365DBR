                    "type": "text",
                    "attrs": {
                      "verseId": "PRO.6.32",
                      "verseOrgIds": [
                        "PRO.6.32"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " doeth it destroyeth his own soul.",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.6.32",
                  "verseOrgIds": [
                    "PRO.6.32"
                  ]
                }
              },
