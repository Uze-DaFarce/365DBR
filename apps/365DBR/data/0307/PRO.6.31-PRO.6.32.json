              },
              {
                "text": " he be found, he shall restore sevenfold; he shall give all the substance of his house. ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.6.31",
                  "verseOrgIds": [
                    "PRO.6.31"
                  ]
