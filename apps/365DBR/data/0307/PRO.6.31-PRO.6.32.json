                      "verseOrgIds": [
                        "PRO.6.32"
                      ]
                    }
                  }
                ]
              },
              {
                "text": " whoso committeth adultery with a woman lacketh understanding: he ",
                "type": "text",
                "attrs": {
                  "verseId": "PRO.6.32",
                  "verseOrgIds": [
                    "PRO.6.32"
                  ]
                }
              },
